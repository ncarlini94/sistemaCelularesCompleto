{
    "version": 2,
    "builds": [
      {
        "src": "server/index.js",
        "use": "@vercel/node"
      }
    ],
    "buildCommand": "npm install && npm run build --prefix client",
    "outputDirectory": "client/build",
    "routes": [
      { "src": "/api/(.*)", "dest": "/server/index.js" },
      { "src": "/(.*)", "dest": "/client/build/$1" }
    ]
  }
  